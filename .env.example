# PayPal REST sandbox credentials. If either is missing, the app runs in mock mode.
# Get these from https://developer.paypal.com (Sandbox tab, then Apps & Credentials).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional. Must stay "sandbox" for this project. Live payments are refused.
PAYPAL_ENV=sandbox

# Optional. Public URL used in PayPal return/cancel links after deploy.
# PUBLIC_BASE_URL=https://your-service.onrender.com

# Optional LLM for invoice parsing. The built-in rule-based parser works without this.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Or a Groq key, which uses https://api.groq.com/openai/v1 by default:
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
